    function startFileUploader(){

    var uploader = new qq.FileUploaderBasic({
        button: document.getElementById('boton'),
        action: '<?= $this->baseUrl() ?>/transactions/bibliotecatesis/upload/',
        debug: false,
        params: {
            cota: document.getElementById("cota").value,
            id: document.getElementById("id").value

        },
        onComplete: function(id, fileName, responseJSON){

            // Si la respuesta contiene "message"
            if (responseJSON && responseJSON.message) {

                // Si la respuesta es un error (success == false), mostrar el modal
                if (!responseJSON.success) {
                    openModal(responseJSON.message); // Abre el modal con el mensaje de error
                }

                if (responseJSON.success) {
                    openModal(responseJSON.message); // Abre el modal con el mensaje de error
                    let archivoContainer = document.getElementById("archivo-container");
                    let archivoNombre = document.getElementById("archivo-nombre");
                    let archivoHidden = document.getElementById("archivo"); // Campo oculto
                        
                    if (archivoContainer && archivoNombre) {
                        archivoHidden.value = fileName; // Guardar valor en el campo oculto
                        archivoNombre.textContent = fileName; // Mostrar nombre en el div
                        archivoContainer.style.display = "flex"; // Mostrar el div
                        }
            }
        }}
    });
};
function openModal(message) {
    // Cambiar mensaje del modal
    document.getElementById("modalMessage").innerText = message;

    // Mostrar el modal
    let modal = document.getElementById("errorModal");
    modal.style.display = "block";

    // Seleccionar todos los formularios abiertos (por si hay varios)
    let forms = document.querySelectorAll(".ui-dialog.ui-widget.ui-widget-content.ui-corner-all.ui-draggable");
    
    let highestZIndex = 0;

    // Buscar el formulario con el z-index más alto
    forms.forEach(form => {
        let zIndex = window.getComputedStyle(form).zIndex;
        if (zIndex && !isNaN(zIndex)) {
            zIndex = parseInt(zIndex, 10);
            if (zIndex > highestZIndex) {
                highestZIndex = zIndex;
            }
        }
    });

    // Seleccionar el overlay
    let overlay = document.querySelector(".ui-widget-overlay");

    if (overlay) {
        // Asignar el z-index al overlay (formulario con mayor z-index +1)
        overlay.style.zIndex = highestZIndex + 1;
    }

    // Asignar el z-index al modal (overlay +1)
    modal.style.zIndex = highestZIndex + 2;
}

function closeModal() {
    // Ocultar el modal
    let modal = document.getElementById("errorModal");
    modal.style.display = "none";

    // Restaurar el z-index original del overlay
    let overlay = document.querySelector(".ui-widget-overlay");
    if (overlay) {
        overlay.style.zIndex = "";
    }
}


</script>
